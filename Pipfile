[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

# Direct dependencies only — transitive packages belong in Pipfile.lock.
# Pipfile.lock is the source of truth; requirements.txt is generated from it
# with `pipenv requirements > requirements.txt` (CI and Render use that file).
[packages]
alembic = "==1.16.4"
click = "==8.2.1"
dash = "==3.1.1"
dash-bootstrap-components = "==2.0.3"
email-validator = "==2.3.0"
flask = "==3.1.1"
flask-caching = "==2.4.1"
flask-limiter = "==4.1.1"
flask-login = "==0.6.3"
flask-migrate = "==4.1.0"
flask-sqlalchemy = "==3.1.1"
flask-wtf = "==1.2.2"
gunicorn = "==23.0.0"
pandas = "==2.3.1"
plotly = "==6.2.0"
polygon-api-client = "==1.15.1"
psycopg2-binary = "==2.9.10"
python-dotenv = {extras = ["cli"], version = "==1.1.1"}
requests = "==2.32.4"
sqlalchemy = "==2.0.41"
wtforms = "==3.2.1"

[dev-packages]
pytest = "==9.1.1"
pytest-cov = "==7.1.0"
ruff = "==0.15.22"

[requires]
python_version = "3.11"
