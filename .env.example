# Copy to .env and fill in: cp .env.example .env

# Any random string; used to sign sessions. Required in production.
SECRET_KEY=any-random-string

# Massive.com API key (legacy variable name kept from Polygon.io).
POLYGON_API_KEY=your_massive_api_key

# Optional: leave unset for the SQLite quickstart (creates app.db locally).
# For the Docker PostgreSQL setup in README.md, use:
# DATABASE_URL=postgresql://stockwatch_user:stockwatch_password@localhost:15433/stockwatch
